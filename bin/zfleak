#!/usr/bin/env zsh

# ============================================================================
# zfleak - Project Environment Manager
# ============================================================================
# A CLI tool to manage project-specific environment configurations
# ============================================================================

set -e

ZFLEAK_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$ZFLEAK_SCRIPT_DIR/../lib/vault.sh"

VERSION="1.0.0"
CONFIG_DIR="${ZFLEAK_CONFIG_DIR:-$HOME/.zfleak.d}"
ARCHIVE_DIR="$CONFIG_DIR/.archive"
PROJECTS_CONFIG="$CONFIG_DIR/projects.conf"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ============================================================================
# Helper Functions
# ============================================================================

print_header() {
    echo "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo "${BLUE}║${NC}  ${CYAN}zfleak${NC} - Project Environment Manager v${VERSION}      ${BLUE}║${NC}"
    echo "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_success() {
    echo "${GREEN}✓${NC} $1"
}

print_error() {
    echo "${RED}✗${NC} $1" >&2
}

print_warning() {
    echo "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo "${CYAN}ℹ${NC} $1"
}

# Restrict project names to safe filename/regex-safe characters to prevent
# path traversal and sed-pattern injection via untrusted input.
_validate_project_name() {
    local name=$1
    if [[ -z "$name" ]] || [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
        print_error "Invalid project name: '$name' (use only letters, numbers, '-' and '_')"
        return 1
    fi
}

_zfleak_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1
    fi
}

_zfleak_is_sensitive() {
    grep -q '^export ZFLEAK_SENSITIVE=true' "$1" 2>/dev/null
}

# ============================================================================
# Command: set-passphrase
# ============================================================================
cmd_set_passphrase() {
    local passphrase confirm
    printf "New reveal passphrase: "
    read -rs passphrase
    echo ""
    printf "Confirm passphrase: "
    read -rs confirm
    echo ""
    
    if [[ -z "$passphrase" ]]; then
        print_error "Passphrase cannot be empty"
        return 1
    fi
    
    if [[ "$passphrase" != "$confirm" ]]; then
        print_error "Passphrases did not match"
        return 1
    fi
    
    _zfleak_sha256 "$passphrase" > "$CONFIG_DIR/.reveal_passphrase"
    chmod 600 "$CONFIG_DIR/.reveal_passphrase"
    print_success "Reveal passphrase set"
}

# Appends a tab-separated audit line: timestamp, tty, project, event.
_zfleak_audit_log() {
    local project_name=$1
    local event=$2
    local tty_name
    tty_name=$(tty 2>/dev/null || echo "unknown")
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tty_name" "$project_name" "$event" >> "$CONFIG_DIR/.audit.log"
    chmod 600 "$CONFIG_DIR/.audit.log"
}

# Verifies the current OS user's login password. Only implemented for
# macOS today. ZFLEAK_TEST_AUTH_OK is a test-only seam (bats can't drive
# a real login-password prompt/dscl in CI) and isn't documented for
# end users.
_zfleak_os_authenticate() {
    local password=$1
    if [[ "$ZFLEAK_TEST_AUTH_OK" == "1" ]]; then
        return 0
    fi
    if [[ "$ZFLEAK_TEST_AUTH_OK" == "0" ]]; then
        return 1
    fi
    if [[ "$(uname)" == "Darwin" ]]; then
        dscl . -authonly "$(whoami)" "$password" >/dev/null 2>&1
        return $?
    fi
    print_error "OS-authenticated unlock is currently only supported on macOS"
    return 1
}

# Prompts for the reveal passphrase and checks it against the stored hash.
# Used by `show --reveal` to gate sensitive projects. Tracks failed
# attempts and locks out reveal after 3, logging every failure/lockout.
_zfleak_gate_reveal() {
    local project_name=$1
    local passphrase_file="$CONFIG_DIR/.reveal_passphrase"
    local lockout_file="$CONFIG_DIR/.lockout"
    local locked_file="$CONFIG_DIR/.locked"
    
    if [[ -f "$locked_file" ]]; then
        print_error "Reveal is locked out after too many failed attempts. Run: zfleak unlock"
        return 1
    fi
    
    if [[ ! -f "$passphrase_file" ]]; then
        print_error "No reveal passphrase set. Run: zfleak set-passphrase"
        return 1
    fi
    
    local attempt
    printf "Passphrase to reveal '%s': " "$project_name"
    read -rs attempt
    echo ""
    
    if [[ "$(_zfleak_sha256 "$attempt")" == "$(cat "$passphrase_file")" ]]; then
        rm -f "$lockout_file"
        return 0
    fi
    
    print_error "Incorrect passphrase"
    _zfleak_audit_log "$project_name" "failed_attempt"
    
    local attempts=0
    [[ -f "$lockout_file" ]] && attempts=$(cat "$lockout_file")
    attempts=$((attempts + 1))
    echo "$attempts" > "$lockout_file"
    chmod 600 "$lockout_file"
    
    if [[ "$attempts" -ge 3 ]]; then
        touch "$locked_file"
        chmod 600 "$locked_file"
        _zfleak_audit_log "$project_name" "lockout"
        print_error "Too many failed attempts. Locked out. Run: zfleak unlock"
    fi
    
    return 1
}

# ============================================================================
# Command: unlock
# ============================================================================
cmd_unlock() {
    local locked_file="$CONFIG_DIR/.locked"
    local lockout_file="$CONFIG_DIR/.lockout"
    
    if [[ ! -f "$locked_file" ]]; then
        print_info "Not currently locked out"
        return 0
    fi
    
    local password
    printf "OS login password to unlock: "
    read -rs password
    echo ""
    
    if ! _zfleak_os_authenticate "$password"; then
        print_error "Authentication failed"
        return 1
    fi
    
    rm -f "$locked_file" "$lockout_file"
    print_success "Unlocked"
}

# ============================================================================
# Command: new-project
# ============================================================================
cmd_new_project() {
    local project_name=$1
    local project_path=$2
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak new-project <name> [path]"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    
    if [[ -f "$config_file" ]]; then
        print_error "Project '$project_name' already exists"
        print_info "Edit: $config_file"
        return 1
    fi
    
    # Create project config from template
    cat > "$config_file" << EOF
# ============================================================================
# ${project_name} - Development Environment
# ============================================================================
# Created: $(date +"%Y-%m-%d")
# ============================================================================

# Flask/Django Configuration (uncomment if needed)
# export FLASK_APP='${project_name}.app:create_app()'
# export FLASK_ENV=development

# Database Configuration
# export DB_HOST=127.0.0.1
# export DB_PORT=5432
# export DB_USER=${project_name}
# export DB_PASSWORD=your_password
# export DB_NAME=${project_name}_dev

# AWS Configuration (uncomment if needed)
# export AWS_REGION=us-east-1
# export AWS_DEFAULT_REGION=us-east-1

# API URLs (uncomment if needed)
# export API_BASE_URL=http://localhost:8000

# Add your project-specific environment variables below:
EOF
    
    # Config files may hold plaintext secrets; restrict to owner-only access
    chmod 600 "$config_file"
    
    # Register project path if provided
    if [[ -n "$project_path" ]]; then
        register_project_path "$project_name" "$project_path"
    fi
    
    print_success "Created project: $project_name"
    print_info "Config file: $config_file"
    
    if [[ -n "$project_path" ]]; then
        print_success "Registered path: $project_path"
        print_info "Auto-detection will activate when you cd into this path"
    else
        print_warning "No path registered. Add manually or use: zfleak register-path $project_name <path>"
    fi
    
    echo ""
    print_info "Edit the config file to add your environment variables"
    echo "Then run: ${GREEN}use-project $project_name${NC}"
}

# ============================================================================
# Command: register-path
# ============================================================================
register_project_path() {
    local project_name=$1
    local project_path=$2
    
    # Create projects.conf if it doesn't exist
    touch "$PROJECTS_CONFIG"
    chmod 600 "$PROJECTS_CONFIG"
    
    # Remove existing entry for this project
    sed -i.bak "/^${project_name}:/d" "$PROJECTS_CONFIG" 2>/dev/null || true
    rm -f "${PROJECTS_CONFIG}.bak"
    
    # Add new entry
    echo "${project_name}:${project_path}" >> "$PROJECTS_CONFIG"
}

cmd_register_path() {
    local project_name=$1
    local project_path=$2
    
    if [[ -z "$project_name" ]] || [[ -z "$project_path" ]]; then
        print_error "Both project name and path are required"
        echo "Usage: zfleak register-path <project-name> <path>"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    if [[ ! -f "$config_file" ]]; then
        print_error "Project '$project_name' does not exist"
        print_info "Create it first: zfleak new-project $project_name"
        return 1
    fi
    
    register_project_path "$project_name" "$project_path"
    
    print_success "Registered path for project: $project_name"
    print_info "Path: $project_path"
    print_info "Auto-detection is now enabled for this project"
}

# ============================================================================
# Command: list-projects
# ============================================================================
cmd_list_projects() {
    echo "${CYAN}Active Projects:${NC}"
    echo ""
    
    if ls "$CONFIG_DIR"/*.zsh &>/dev/null; then
        for file in "$CONFIG_DIR"/*.zsh; do
            [[ "$file" == *"switcher.zsh" ]] && continue
            [[ "$file" == *"common.zsh" ]] && continue
            
            local name=$(basename "$file" .zsh)
            local path=$(grep "^${name}:" "$PROJECTS_CONFIG" 2>/dev/null | cut -d: -f2-)
            
            if [[ -n "$path" ]]; then
                echo "  ${GREEN}•${NC} ${CYAN}${name}${NC} → ${path}"
            else
                echo "  ${YELLOW}•${NC} ${CYAN}${name}${NC} (no auto-detection path)"
            fi
        done
    else
        print_info "No active projects yet"
    fi
    
    echo ""
    echo "${CYAN}Archived Projects:${NC}"
    echo ""
    
    if ls "$ARCHIVE_DIR"/*.zsh &>/dev/null; then
        for file in "$ARCHIVE_DIR"/*.zsh; do
            local name=$(basename "$file" .zsh)
            echo "  ${YELLOW}•${NC} ${name}"
        done
    else
        print_info "No archived projects"
    fi
}

# ============================================================================
# Command: archive
# ============================================================================
cmd_archive() {
    local project_name=$1
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak archive <project-name>"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    
    if [[ ! -f "$config_file" ]]; then
        print_error "Project '$project_name' not found"
        return 1
    fi
    
    # Move to archive
    mkdir -p "$ARCHIVE_DIR"
    chmod 700 "$ARCHIVE_DIR"
    mv "$config_file" "$ARCHIVE_DIR/"
    
    # Remove from projects.conf
    sed -i.bak "/^${project_name}:/d" "$PROJECTS_CONFIG" 2>/dev/null || true
    rm -f "${PROJECTS_CONFIG}.bak"
    
    print_success "Archived project: $project_name"
    print_info "Moved to: $ARCHIVE_DIR/${project_name}.zsh"
}

# ============================================================================
# Command: restore
# ============================================================================
cmd_restore() {
    local project_name=$1
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak restore <project-name>"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local archive_file="$ARCHIVE_DIR/${project_name}.zsh"
    
    if [[ ! -f "$archive_file" ]]; then
        print_error "Archived project '$project_name' not found"
        return 1
    fi
    
    # Move back to active
    mv "$archive_file" "$CONFIG_DIR/"
    
    print_success "Restored project: $project_name"
    print_info "Config file: $CONFIG_DIR/${project_name}.zsh"
    print_warning "Remember to register the project path if needed"
}

# ============================================================================
# Command: vault-backend
# ============================================================================
cmd_vault_backend() {
    echo "${ZFLEAK_VAULT_BACKEND:-$(_zfleak_default_vault_backend)}"
}

# ============================================================================
# Command: migrate
# ============================================================================
cmd_migrate() {
    local project_name=$1
    local to_backend=""
    [[ "$2" == "--to-backend" ]] && to_backend=$3
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak migrate <project-name> --to-backend <name>"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    if [[ -z "$to_backend" ]]; then
        print_error "Target backend is required"
        echo "Usage: zfleak migrate <project-name> --to-backend <name>"
        return 1
    fi
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    if [[ ! -f "$config_file" ]]; then
        print_error "Project '$project_name' not found"
        return 1
    fi
    
    local tmp_file
    tmp_file="$(mktemp)"
    local migrated=0
    local var_name value vault_key
    
    while IFS= read -r line; do
        if [[ "$line" =~ ^export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            var_name="${match[1]}"
            value="${match[2]}"
            vault_key="${project_name}/${var_name}"
            if ! ZFLEAK_VAULT_BACKEND="$to_backend" _vault_set "$vault_key" "$value"; then
                print_error "Failed to store $var_name in backend '$to_backend'"
                rm -f "$tmp_file"
                return 1
            fi
            echo "# zfleak:secret ${var_name}=${vault_key}" >> "$tmp_file"
            migrated=$((migrated + 1))
        else
            echo "$line" >> "$tmp_file"
        fi
    done < "$config_file"
    
    mv "$tmp_file" "$config_file"
    chmod 600 "$config_file"
    
    print_success "Migrated $migrated secret(s) from '$project_name' to backend '$to_backend'"
}

# ============================================================================
# Command: run
# ============================================================================
# Resolves a project's environment (plain export lines + # zfleak:secret
# references) into the environment of a single child process only -
# nothing is exported into the calling shell, unlike use-project.
cmd_run() {
    local project_name=$1
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak run <project-name> -- <command...>"
        return 1
    fi
    shift
    
    _validate_project_name "$project_name" || return 1
    
    if [[ "$1" != "--" ]]; then
        print_error "Missing '--' separator before the command"
        echo "Usage: zfleak run <project-name> -- <command...>"
        return 1
    fi
    shift
    
    if [[ $# -eq 0 ]]; then
        print_error "A command to run is required after '--'"
        echo "Usage: zfleak run <project-name> -- <command...>"
        return 1
    fi
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    if [[ ! -f "$config_file" ]]; then
        config_file="$ARCHIVE_DIR/${project_name}.zsh"
        if [[ ! -f "$config_file" ]]; then
            print_error "Project '$project_name' not found"
            return 1
        fi
    fi
    
    local -a env_pairs
    local var_name value vault_key
    
    while IFS= read -r line; do
        if [[ "$line" =~ ^export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            var_name="${match[1]}"
            value="${match[2]}"
            env_pairs+=("${var_name}=${value}")
        elif [[ "$line" =~ ^#[[:space:]]*zfleak:secret[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=(.+)$ ]]; then
            var_name="${match[1]}"
            vault_key="${match[2]}"
            if ! value="$(_vault_get "$vault_key")"; then
                print_error "Failed to resolve secret '$vault_key' for \$$var_name"
                return 1
            fi
            env_pairs+=("${var_name}=${value}")
        fi
    done < "$config_file"
    
    env "${env_pairs[@]}" "$@"
}

# ============================================================================
# Command: edit
# ============================================================================
cmd_edit() {
    local project_name=$1
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak edit <project-name>"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    
    if [[ ! -f "$config_file" ]]; then
        config_file="$ARCHIVE_DIR/${project_name}.zsh"
        if [[ ! -f "$config_file" ]]; then
            print_error "Project '$project_name' not found"
            return 1
        fi
    fi
    
    local editor="${EDITOR:-$(command -v vim || command -v nano)}"
    $editor "$config_file"
}

# ============================================================================
# Command: show
# ============================================================================
cmd_show() {
    local project_name=$1
    local reveal=false
    [[ "$2" == "--reveal" ]] && reveal=true
    
    if [[ -z "$project_name" ]]; then
        print_error "Project name is required"
        echo "Usage: zfleak show <project-name> [--reveal]"
        return 1
    fi
    
    _validate_project_name "$project_name" || return 1
    
    local config_file="$CONFIG_DIR/${project_name}.zsh"
    
    if [[ ! -f "$config_file" ]]; then
        config_file="$ARCHIVE_DIR/${project_name}.zsh"
        if [[ ! -f "$config_file" ]]; then
            print_error "Project '$project_name' not found"
            return 1
        fi
    fi
    
    echo "${CYAN}Configuration for: ${project_name}${NC}"
    echo "${CYAN}File: ${config_file}${NC}"
    echo ""
    
    if [[ "$reveal" == true ]] && _zfleak_is_sensitive "$config_file"; then
        _zfleak_gate_reveal "$project_name" || return 1
    fi
    
    if [[ "$reveal" == true ]]; then
        cat "$config_file"
    else
        print_warning "Secret values are masked. Use 'zfleak show $project_name --reveal' to view them."
        echo ""
        sed -E 's/^(export[[:space:]]+[A-Za-z_][A-Za-z0-9_]*=).+$/\1********/' "$config_file"
    fi
}

# ============================================================================
# Command: help
# ============================================================================
cmd_help() {
    print_header
    echo "Usage: ${CYAN}zfleak${NC} <command> [options]"
    echo ""
    echo "${YELLOW}Commands:${NC}"
    echo ""
    echo "  ${GREEN}new-project${NC} <name> [path]     Create a new project configuration"
    echo "  ${GREEN}register-path${NC} <name> <path>   Register auto-detection path for a project"
    echo "  ${GREEN}list${NC}                          List all projects"
    echo "  ${GREEN}edit${NC} <name>                   Edit project configuration"
    echo "  ${GREEN}show${NC} <name> [--reveal]        Display project configuration (masked by default)"
    echo "  ${GREEN}archive${NC} <name>                Move project to archive"
    echo "  ${GREEN}restore${NC} <name>                Restore project from archive"
    echo "  ${GREEN}set-passphrase${NC}                Set the passphrase gating --reveal on sensitive projects"
    echo "  ${GREEN}unlock${NC}                        Clear a reveal lockout (requires OS authentication)"
    echo "  ${GREEN}vault-backend${NC}                 Show the resolved secret vault backend"
    echo "  ${GREEN}migrate${NC} <name> --to-backend <b>  Move a project's plaintext secrets into a vault backend"
    echo "  ${GREEN}run${NC} <name> -- <command...>    Run a command with the project's env in that process only"
    echo "  ${GREEN}help${NC}                          Show this help message"
    echo "  ${GREEN}version${NC}                       Show version information"
    echo ""
    echo "${YELLOW}Examples:${NC}"
    echo ""
    echo "  # Create a new project"
    echo "  ${CYAN}zfleak new-project myapp ~/projects/myapp${NC}"
    echo ""
    echo "  # Register auto-detection path"
    echo "  ${CYAN}zfleak register-path myapp ~/projects/myapp${NC}"
    echo ""
    echo "  # Edit project config"
    echo "  ${CYAN}zfleak edit myapp${NC}"
    echo ""
    echo "  # List all projects"
    echo "  ${CYAN}zfleak list${NC}"
    echo ""
}

# ============================================================================
# Main Command Router
# ============================================================================

main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        return 0
    fi

    if [[ "$1" == "--backend" ]]; then
        export ZFLEAK_VAULT_BACKEND="$2"
        shift 2
    fi
    
    local command=$1
    shift
    
    case "$command" in
        new-project|new)
            cmd_new_project "$@"
            ;;
        register-path|register)
            cmd_register_path "$@"
            ;;
        list|ls)
            cmd_list_projects "$@"
            ;;
        archive)
            cmd_archive "$@"
            ;;
        restore)
            cmd_restore "$@"
            ;;
        edit)
            cmd_edit "$@"
            ;;
        show|cat)
            cmd_show "$@"
            ;;
        set-passphrase)
            cmd_set_passphrase "$@"
            ;;
        unlock)
            cmd_unlock "$@"
            ;;
        vault-backend)
            cmd_vault_backend "$@"
            ;;
        migrate)
            cmd_migrate "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        version|-v|--version)
            echo "zfleak version $VERSION"
            ;;
        help|-h|--help|"")
            cmd_help
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            cmd_help
            return 1
            ;;
    esac
}

main "$@"
